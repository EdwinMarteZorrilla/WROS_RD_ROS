#!/usr/bin/env python3
import rclpy
from rclpy.node import Node
from geometry_msgs.msg import Twist
import time

# ==========================================================
# --- CmdVelPublisher ---
# ==========================================================
class CmdVelPublisher(Node):
    def __init__(self):
        super().__init__('cmd_vel_publisher')
        # Make sure this topic matches your robot
        self.pub = self.create_publisher(Twist, '/cmd_vel', 10)

    def publish_rotation(self, angular_speed):
        msg = Twist()
        msg.angular.z = angular_speed
        self.pub.publish(msg)

    def stop_rotation(self):
        msg = Twist()
        msg.angular.z = 0.0
        self.pub.publish(msg)

# ==========================================================
# --- Motor Calibration Main ---
# ==========================================================
def main(args=None):
    rclpy.init(args=args)
    cmd_node = CmdVelPublisher()

    # --- Calibration Parameters ---
    start_speed = 0.10     # Start very low
    max_speed = 1.0        # Cap the test speed
    increment = 0.02       # How much to increase speed each test
    duration = 1.0         # How long to send the command

    current_speed = start_speed

    print("?? Starting Motor Calibration Test...")
    print("Goal: Find the minimum speed command that causes movement.")
    print("-" * 40)

    try:
        while rclpy.ok() and current_speed <= max_speed:
            print(f"Testing speed: {current_speed:.2f}")

            # 1. Publish command
            cmd_node.publish_rotation(current_speed)
            time.sleep(duration)

            # 2. Stop
            cmd_node.stop_rotation()
            time.sleep(1.0)  # Pause to observe results

            # 3. Increase speed for the next test
            current_speed += increment

        print("? Test finished (reached max speed).")

    except KeyboardInterrupt:
        print("\n? Test stopped by user. Stopping robot...")
        print(f"Last tested speed: {current_speed:.2f}")

    finally:
        cmd_node.stop_rotation()
        cmd_node.destroy_node()
        rclpy.shutdown()
        print("Robot stopped. Node shut down.")

if __name__ == "__main__":
    main()
