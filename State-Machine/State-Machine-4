#!/usr/bin/env python3
import time, subprocess, json, paho.mqtt.client as mqtt

# ---------------- CONFIGURATION ----------------
BROKERS = ["192.168.86.43", "192.168.149.148"]
BROKER_PORT = 1883
TOPIC_FIRE = "alerta/fuego"
RPI_ID = "FIREVOLX_ROBOT"

# Script paths
NAVIGATION_SCRIPT = "Navigation_Full_Nav2-C.py"
FIRE_FIGHT_SCRIPT = "MQTT-TRANSMITTER-PUMP"
SERVO_SCRIPT = "PUMP-SERVO"


class FireFighterRobot:
    def __init__(self):
        self.state = "IDLE"
        self.fire_detected = False
        self.smoke_detected = False
        self.last_rpi = None

        # MQTT setup
        self.mqtt_clients = []
        for ip in BROKERS:
            client = mqtt.Client()
            client.on_connect = self.on_connect
            client.on_message = self.on_message
            try:
                client.connect(ip, BROKER_PORT, 60)
                client.loop_start()
                print(f"[MQTT] Connected to broker {ip}")
            except Exception as e:
                print(f"[MQTT] Could not connect to {ip}: {e}")
            self.mqtt_clients.append(client)

    # ---------------- MQTT ----------------
    def on_connect(self, client, userdata, flags, rc):
        client.subscribe(TOPIC_FIRE)
        print(f"[MQTT] Subscribed to {TOPIC_FIRE}")

    def on_message(self, client, userdata, msg):
        try:
            payload = json.loads(msg.payload.decode())
            label = payload.get("label", "").lower()
            rpi_id = payload.get("rpi_id", "UNKNOWN")

            if msg.topic == TOPIC_FIRE:
                if label == "red_lid":
                    print(f"[MQTT] RED_LID detected from {rpi_id}")
                    self.fire_detected = True
                    self.last_rpi = rpi_id
                elif label == "person_smoking":
                    print(f"[MQTT] PERSON_SMOKING detected from {rpi_id}")
                    self.smoke_detected = True
                    self.last_rpi = rpi_id

        except Exception as e:
            print(f"[MQTT] Error processing message: {e}")

    # ---------------- STATE MACHINE ----------------
    def run(self):
        while True:
            if self.state == "IDLE":
                print("[STATE] IDLE — Waiting for MQTT signal...")
                if self.fire_detected:
                    print("[STATE] RED_LID alert received — starting sequence")
                    self.state = "NAVIGATION"
                elif self.smoke_detected:
                    print("[STATE] PERSON_SMOKING alert received — only NAVIGATION")
                    self.state = "NAVIGATION_SMOKE"

            elif self.state == "NAVIGATION":
                self.navigation_state()
                if self.fire_detected:
                    print("[INFO] Navigation completed — activating pump and servo")
                    self.state = "FIRE_FIGHTING"
                else:
                    self.state = "DONE"

            elif self.state == "FIRE_FIGHTING":
                self.fire_fighting_state()
                self.state = "DONE"

            elif self.state == "DONE":
                self.done_state()
                self.state = "IDLE"

            elif self.state == "NAVIGATION_SMOKE":
                self.navigation_state()
                print("[STATE] NAVIGATION_SMOKE completed — returning to IDLE")
                self.smoke_detected = False
                self.last_rpi = None
                self.state = "IDLE"

            time.sleep(0.2)

    # ---------------- STATE DEFINITIONS ----------------

    def navigation_state(self):
        try:
            print("[STATE] NAVIGATION: Moving toward target area...")
            # Ejecutar navegación y esperar a que termine
            proc = subprocess.Popen(["python3", NAVIGATION_SCRIPT, str(self.last_rpi)])
            proc.wait()  # <-- espera real hasta que el script termine
            print("[INFO] Navigation script finished.")
        except Exception as e:
            print(f"[ERROR] NAVIGATION: {e}")

    def fire_fighting_state(self):
        print("[STATE] FIRE_FIGHTING: Activating pump and servo simultaneously...")
        try:
            pump = subprocess.Popen(["python3", FIRE_FIGHT_SCRIPT])
            servo = subprocess.Popen(["python3", SERVO_SCRIPT])
            time.sleep(6)  # Duración del apagado
            pump.terminate()
            servo.terminate()
            print("[ACTION] Fire extinguishing completed.")
        except Exception as e:
            print(f"[ERROR] FIRE_FIGHTING: {e}")

    def done_state(self):
        print("[STATE] DONE: Resetting to IDLE.")
        self.fire_detected = False
        self.last_rpi = None


if __name__ == "__main__":
    FireFighterRobot().run()
