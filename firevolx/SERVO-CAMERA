import rclpy
from rclpy.node import Node
from ros_robot_controller_msgs.msg import SetPWMServoState, PWMServoState
from time import time

class DualServoController(Node):
    def __init__(self):
        super().__init__('dual_servo_controller')

        # --- Parameters for vertical servo ---
        self.declare_parameter('servo_vertical_id', 1)
        self.declare_parameter('vertical_angle_min',1300)  
        self.declare_parameter('vertical_angle_max', 1800)  
        self.declare_parameter('vertical_neutral', 1500)    

        # --- Parameters for horizontal servo ---
        self.declare_parameter('servo_horizontal_id', 2)
        self.declare_parameter('horizontal_angle_min', 1050)  
        self.declare_parameter('horizontal_angle_max',1950)  
        self.declare_parameter('horizontal_neutral', 1500)    

        # --- Motion & smoothing ---
        self.declare_parameter('motion_duration', 5.0) 
        self.declare_parameter('smooth_step', 7) 
        self.declare_parameter('timer_period', 0.02) 

        # --- Load parameters ---
        self.servo_vertical_id = self.get_parameter('servo_vertical_id').value
        self.vertical_angle_min = self.get_parameter('vertical_angle_min').value
        self.vertical_angle_max = self.get_parameter('vertical_angle_max').value
        self.vertical_neutral = self.get_parameter('vertical_neutral').value

        self.servo_horizontal_id = self.get_parameter('servo_horizontal_id').value
        self.horizontal_angle_min = self.get_parameter('horizontal_angle_min').value
        self.horizontal_angle_max = self.get_parameter('horizontal_angle_max').value
        self.horizontal_neutral = self.get_parameter('horizontal_neutral').value

        self.motion_duration = self.get_parameter('motion_duration').value
        self.smooth_step = self.get_parameter('smooth_step').value
        self.timer_period = self.get_parameter('timer_period').value

        # --- Publisher ---
        self.publisher = self.create_publisher(SetPWMServoState,
                                               '/ros_robot_controller/pwm_servo/set_state', 10)

        # --- Control state for smoothing ---
        self.vertical_position = float(self.vertical_neutral)
        self.vertical_target = float(self.vertical_angle_max)
        self.vertical_moving_to_min = False

        self.horizontal_position = float(self.horizontal_neutral)
        self.horizontal_target = float(self.horizontal_angle_max)
        self.horizontal_moving_to_min = False

        self.start_time = time()

        # --- Timer ---
        self.timer = self.create_timer(self.timer_period, self.timer_callback)
        self.get_logger().info("Dual servo smooth motion started.")

    def set_servo_position(self, servo_id, position):
        msg = SetPWMServoState()
        servo_state = PWMServoState()
        servo_state.id = [servo_id]
        servo_state.position = [int(round(position))]
        servo_state.offset = [0]
        msg.state.append(servo_state)
        self.publisher.publish(msg)

    def timer_callback(self):
        elapsed = time() - self.start_time

        # --- Vertical servo motion ---
        if elapsed <= self.motion_duration:
            self.vertical_target = self.vertical_angle_min if self.vertical_moving_to_min else self.vertical_angle_max
        else:
            self.vertical_target = self.vertical_neutral

        diff_v = self.vertical_target - self.vertical_position
        if abs(diff_v) > self.smooth_step:
            step_v = self.smooth_step if diff_v > 0 else -self.smooth_step
            self.vertical_position += step_v
        else:
            self.vertical_position = self.vertical_target
            if elapsed <= self.motion_duration:
                self.vertical_moving_to_min = not self.vertical_moving_to_min

        self.set_servo_position(self.servo_vertical_id, self.vertical_position)

        # --- Horizontal servo motion ---
        if elapsed <= self.motion_duration:
            self.horizontal_target = self.horizontal_angle_min if self.horizontal_moving_to_min else self.horizontal_angle_max
        else:
            self.horizontal_target = self.horizontal_neutral

        diff_h = self.horizontal_target - self.horizontal_position
        if abs(diff_h) > self.smooth_step:
            step_h = self.smooth_step if diff_h > 0 else -self.smooth_step
            self.horizontal_position += step_h
        else:
            self.horizontal_position = self.horizontal_target
            if elapsed <= self.motion_duration:
                self.horizontal_moving_to_min = not self.horizontal_moving_to_min

        self.set_servo_position(self.servo_horizontal_id, self.horizontal_position)

# -----------------------------------------------------------------------------

def main(args=None):
    rclpy.init(args=args)
    node = DualServoController()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        node.get_logger().info("Interrupted by user. Moving both servos to neutral...")
        while (abs(node.vertical_position - node.vertical_neutral) > node.smooth_step or
               abs(node.horizontal_position - node.horizontal_neutral) > node.smooth_step):
            if abs(node.vertical_position - node.vertical_neutral) > node.smooth_step:
                step_v = node.smooth_step if node.vertical_neutral > node.vertical_position else -node.smooth_step
                node.vertical_position += step_v
                node.set_servo_position(node.servo_vertical_id, node.vertical_position)
            if abs(node.horizontal_position - node.horizontal_neutral) > node.smooth_step:
                step_h = node.smooth_step if node.horizontal_neutral > node.horizontal_position else -node.smooth_step
                node.horizontal_position += step_h
                node.set_servo_position(node.servo_horizontal_id, node.horizontal_position)
            import time as pytime
            pytime.sleep(node.timer_period)
        
        node.set_servo_position(node.servo_vertical_id, node.vertical_neutral)
        node.set_servo_position(node.servo_horizontal_id, node.horizontal_neutral)
    finally:
        node.destroy_node()
        rclpy.shutdown()

if __name__ == "__main__":
    main()
